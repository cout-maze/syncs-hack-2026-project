# Copy to .env for local development: cp .env.example .env

# --- App ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins (Vite dev server, deployed web app, ...)
CORS_ORIGIN=http://localhost:5173

# --- Database (SQLite via Prisma for the hackathon; swap the provider in prisma/schema.prisma to move to Postgres later) ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRES_IN=24h

# --- Advisor (Claude API) ---
# Server-side only — never sent to the browser. Leave blank to run the Advisor
# module in canned-fallback-only mode (fallback: true on every response).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Abort the LLM call and fall back after this many ms (spec: ~10s budget).
ADVISOR_TIMEOUT_MS=10000

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
