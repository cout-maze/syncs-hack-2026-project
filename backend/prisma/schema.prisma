// Rebuild My City — database schema.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("user")
  createdAt    DateTime @default(now())

  cities    City[]
  votes     Vote[]
  proposals Proposal[] @relation("ProposalAuthor")

  @@map("users")
}

model City {
  id          String   @id
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String   @default("My City")
  gridWidth   Int      @default(10)
  gridHeight  Int      @default(10)
  blockBudget Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks     PlacedBlock[]
  simulation SimulationResult?

  @@index([ownerId])
  @@map("cities")
}

model PlacedBlock {
  id     String @id
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  typeId String
  x      Int
  y      Int

  @@unique([cityId, x, y])
  @@index([cityId])
  @@map("placed_blocks")
}

model SimulationResult {
  id            String   @id
  cityId        String   @unique
  city          City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  metrics       Json
  journeys      Json
  events        Json
  engineVersion String?
  runAt         DateTime @default(now())

  @@map("simulation_results")
}

model Proposal {
  id                 String   @id
  title              String
  issue              String?
  description        String
  locationX          Int?
  locationY          Int?
  changes            Json?
  blockCost          Int      @default(0)
  expectedBenefits   Json
  affectedPersonaIds Json
  votingMetrics      Json
  // Legacy coordinate/change fields are retained for old clients and advisor modules.
  x                  Int?
  y                  Int?
  changeType         String?
  blockTypeId        String?
  status             String   @default("open")
  createdById        String?
  createdBy          User?    @relation("ProposalAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  closedAt           DateTime?

  votes Vote[]

  @@map("proposals")
}

model Vote {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  // One row per (user, proposal, metric). "overall" is the legacy alias.
  metric     String   @default("overall")
  support    Boolean  @default(false)
  value      String?
  updatedAt  DateTime @updatedAt

  @@unique([userId, proposalId, metric])
  @@index([proposalId])
  @@map("votes")
}
