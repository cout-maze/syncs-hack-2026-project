// Rebuild My City — database schema.
// Prisma v7: connection info lives in `prisma7.config.ts`, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- Auth -------------------------------------------------------------

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())

  cities    City[]
  votes     Vote[]
  proposals Proposal[]

  @@map("users")
}

// --- City / Map -------------------------------------------------------

model City {
  id          String   @id
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String   @default("My City")
  gridWidth   Int      @default(10)
  gridHeight  Int      @default(10)
  blockBudget Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks     PlacedBlock[]
  simulation SimulationResult?

  @@index([ownerId])
  @@map("cities")
}

model PlacedBlock {
  id     String @id
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  typeId String
  x      Int
  y      Int

  @@unique([cityId, x, y])
  @@index([cityId])
  @@map("placed_blocks")
}

// The simulation runs client-side (FE #2 owns the engine); the backend only
// stores the latest result per city, verbatim, so it survives reloads.
model SimulationResult {
  id            String   @id
  cityId        String   @unique
  city          City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  metrics       Json
  journeys      Json
  events        Json
  engineVersion String?
  runAt         DateTime @default(now())

  @@map("simulation_results")
}

// --- Proposals & voting ---------------------------------------------------

model Proposal {
  id          String    @id
  title       String
  description String
  x           Int
  y           Int
  changeType  String    // add | replace | remove
  blockTypeId String?   // null iff remove
  status      String    @default("open") // open | closed
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  votes Vote[]

  @@map("proposals")
}

model Vote {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  value      String   // up | down
  updatedAt  DateTime @updatedAt

  @@unique([userId, proposalId])
  @@index([proposalId])
  @@map("votes")
}
