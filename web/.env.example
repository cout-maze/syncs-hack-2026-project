# Which backend the app talks to.
#   msw     - in-browser stateful mocks (default; no backend needed)
#   prism   - the four Prism processes from the OpenAPI specs
#   real    - the Node backend from BE #1 / BE #2
VITE_API_MODE=msw

# Used when VITE_API_MODE is "real" (or "prism" with a gateway in front).
VITE_API_URL=http://localhost:3000/api/v1
